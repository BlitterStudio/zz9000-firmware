<: if { $mm2s_enabled == 1 && $mm2s_async_clocks == 1} { :>

set_false_path -to [get_pins -of [get_cells -hier -filter {NAME =~*mm2s_cdc_1/CAPTURE_MM2S.*_reg*}] -filter {REF_PIN_NAME =~D}] 

<: } :>

<: if { $s2mm_enabled == 1 && $s2mm_async_clocks == 1} { :>

set_false_path  -to [get_pins -of [get_cells -hier -filter {NAME =~*s2mm_cdc_1/CAPTURE_S2MM.*_reg*}] -filter {REF_PIN_NAME =~D}] 

<: if { $s2mm_data_format < 2} { :>
set_false_path  -to [get_pins -of [get_cells -hier -filter {NAME =~*s2mm_registers_1/aes_channel_status_reg*}] -filter {REF_PIN_NAME =~D}] 
<: } :>

<: } :>
