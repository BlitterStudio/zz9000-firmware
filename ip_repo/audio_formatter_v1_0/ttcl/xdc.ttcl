<: ;#Component and file information :>
<: set ComponentName [getComponentNameString] :>
<: setOutputDirectory "./" :>
<: setFileName $ComponentName :>
<: setFileExtension ".xdc" :>
<: set mm2s_enabled [getIntValue "C_INCLUDE_MM2S"] :>
<: set s2mm_enabled [getIntValue "C_INCLUDE_S2MM"] :>
<: set s2mm_async_clocks [getIntValue "C_S2MM_ASYNC_CLOCK"] :>
<: set mm2s_async_clocks [getIntValue "C_MM2S_ASYNC_CLOCK"] :>
<: set s2mm_data_format [getIntValue "C_S2MM_DATAFORMAT"] :>
