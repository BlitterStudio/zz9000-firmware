//TestExdes
`timescale 1ns/1ps
(* DowngradeIPIdentifiedWarnings="yes" *)


module <=: ComponentName :>_exdes 
   (
  clk_27mhz,
  clk_in,
  reset,
//  pass,
//  fail,
//  done
  Error_mm2s,
  Error_s2mm
);
  input clk_27mhz;
  input clk_in; // 100Mhz to Clk_wiz
  input reset;  // Reset to clk_wiz
  output Error_mm2s;
  output Error_s2mm;

//----- Clock generation-----Wizard---
wire locked;
wire locked_axi;
wire lite_clk;
wire read_clk;
wire audio_clk;
wire write_clk;
wire lite_aresetn;
reg lite_aresetn_1;
wire read_aresetn;
wire write_aresetn;
wire audio_aresetn;
reg [9:0] locked_del;
reg [9:0] locked_del_read;
reg [9:0] locked_del_write;
reg [9:0] locked_del_audio;

reg start_write_cdc;
reg start_write1;
reg start_write;
reg start_write_1;
reg start_read_cdc;
reg start_read1;
reg start_read;

wire [31:0]AXI_ARADDR;
wire AXI_ARREADY;
wire AXI_ARVALID;
wire [31:0]AXI_AWADDR;
wire AXI_AWREADY;
wire AXI_AWVALID;
wire AXI_BREADY;
wire [1:0]AXI_BRESP;
wire AXI_BVALID;
wire [31:0]AXI_RDATA;
wire AXI_RREADY;
wire [1:0]AXI_RRESP;
wire AXI_RVALID;
wire [31:0]AXI_WDATA;
wire [3:0]AXI_WSTRB;
wire AXI_WREADY;
wire AXI_WVALID;
wire start_apg;

wire [31:0]AXI_ARADDR_1;
wire AXI_ARREADY_1;
wire AXI_ARVALID_1;
wire [31:0]AXI_AWADDR_1;
wire AXI_AWREADY_1;
wire AXI_AWVALID_1;
wire AXI_BREADY_1;
wire [1:0]AXI_BRESP_1;
wire AXI_BVALID_1;
wire [31:0]AXI_RDATA_1;
wire AXI_RREADY_1;
wire [1:0]AXI_RRESP_1;
wire AXI_RVALID_1;
wire [31:0]AXI_WDATA_1;
wire [3:0]AXI_WSTRB_1;
wire AXI_WREADY_1;
wire AXI_WVALID_1;


wire Irq_mm2s;
wire Irq_s2mm;
wire Irq_s2mm_1;
wire [<=: addr_width :>-1:0]m_axi_mm2s_ARADDR;
wire [1:0]m_axi_mm2s_ARBURST;
wire [3:0]m_axi_mm2s_ARCACHE;
wire [7:0]m_axi_mm2s_ARLEN;
wire [2:0]m_axi_mm2s_ARPROT;
wire m_axi_mm2s_ARREADY;
wire [2:0]m_axi_mm2s_ARSIZE;
wire [3:0]m_axi_mm2s_ARUSER;
wire m_axi_mm2s_ARVALID;
wire [31:0]m_axi_mm2s_RDATA_dum;
wire [31:0]m_axi_mm2s_RDATA;
wire m_axi_mm2s_RLAST;
wire m_axi_mm2s_RREADY;
wire [1:0]m_axi_mm2s_RRESP;
wire m_axi_mm2s_RVALID;
wire [<=: addr_width_s2mm :>-1:0]m_axi_s2mm_AWADDR;
wire [1:0]m_axi_s2mm_AWBURST;
wire [3:0]m_axi_s2mm_AWCACHE;
wire [7:0]m_axi_s2mm_AWLEN;
wire [2:0]m_axi_s2mm_AWPROT;
wire m_axi_s2mm_AWREADY;
wire [2:0]m_axi_s2mm_AWSIZE;
wire [3:0]m_axi_s2mm_AWUSER;
wire m_axi_s2mm_AWVALID;
wire m_axi_s2mm_BREADY;
wire [1:0]m_axi_s2mm_BRESP;
wire m_axi_s2mm_BVALID;
wire [31:0]m_axi_s2mm_WDATA;
wire m_axi_s2mm_WLAST;
wire m_axi_s2mm_WREADY;
wire [3:0]m_axi_s2mm_WSTRB;
wire m_axi_s2mm_WVALID;
wire [31:0]m_axis_mm2s_TDATA;
wire [7:0]m_axis_mm2s_TID;
wire m_axis_mm2s_TREADY;
wire m_axis_mm2s_TVALID;
wire [31:0]s_axis_s2mm_TDATA;
wire [7:0]s_axis_s2mm_TID;
wire s_axis_s2mm_TREADY;
wire s_axis_s2mm_TVALID;
wire [31:0]s_axis_s2mm_TDATA_1;
wire [7:0]s_axis_s2mm_TID_1;
wire s_axis_s2mm_TREADY_1;
wire s_axis_s2mm_TVALID_1;

wire [<=: addr_width :>-1:0]m_axi_s2mm_AWADDR_1;
wire [1:0]m_axi_s2mm_AWBURST_1;
wire [3:0]m_axi_s2mm_AWCACHE_1;
wire [7:0]m_axi_s2mm_AWLEN_1;
wire [2:0]m_axi_s2mm_AWPROT_1;
wire m_axi_s2mm_AWREADY_1;
wire [2:0]m_axi_s2mm_AWSIZE_1;
wire [3:0]m_axi_s2mm_AWUSER_1;
wire m_axi_s2mm_AWVALID_1;
wire m_axi_s2mm_BREADY_1;
wire [1:0]m_axi_s2mm_BRESP_1;
wire m_axi_s2mm_BVALID_1;
wire [31:0]m_axi_s2mm_WDATA_1;
wire m_axi_s2mm_WLAST_1;
wire m_axi_s2mm_WREADY_1;
wire [3:0]m_axi_s2mm_WSTRB_1;
wire m_axi_s2mm_WVALID_1;

wire [31:0] BRAM_RdData_A_1;
wire [31:0] BRAM_WrData_A_1;
wire BRAM_Clk_A_1;
wire BRAM_Rst_A_1;
wire BRAM_En_A_1;
wire [(32 /8) -1:0] BRAM_WE_A_1;
wire [11:0] BRAM_Addr_A_1;


wire [31:0] BRAM_RdData_A;
wire [31:0] BRAM_WrData_A;
wire BRAM_Clk_A;
wire BRAM_Rst_A;
wire BRAM_En_A;
wire [(32 /8) -1:0] BRAM_WE_A;
wire [11:0] BRAM_Addr_A;

wire DataChk_InSync;
wire DataChk_Error;
reg s2mm_good;

assign Error_mm2s = (~DataChk_InSync) || DataChk_Error;

clk_wiz_0 CLOCK_GEN_INST( 
           .clk_in1   (clk_in ),
           .reset       (reset     ),
           .locked      (locked    ),
           .clk_out1    (lite_clk), // 33Mhz
           .clk_out2    (read_clk), // 50Mhz
           .clk_out3    (audio_clk), // 24.576Mhz, to be used for patgen and formatter output
           .clk_out4    (write_clk) // 70Mhz
	   );

always @ ( posedge write_clk) begin
if (~locked || reset) begin
  locked_del <= 0;
end
else begin
  locked_del [0] <= locked;
  locked_del [9:1] <= locked_del [8:0];
end
end

assign lite_aresetn = locked_del[9];


always @ ( posedge read_clk) begin
if (~locked || reset) begin
  locked_del_read <= 0;
  start_read_cdc <= 1'b0;
  start_read1 <= 1'b0;
  start_read <= 1'b0;
end
else begin
  locked_del_read [0] <= locked;
  locked_del_read [9:1] <= locked_del_read [8:0];
  start_read_cdc <= start_apg;
  start_read1 <= start_read_cdc;
  start_read <= start_read1;
end
end

assign read_aresetn = locked_del_read[9];

always @ ( posedge write_clk) begin
if (~locked || reset) begin
  locked_del_write <= 0;
  start_write_cdc <= 1'b0;
  start_write1 <= 1'b0;
  start_write <= 1'b0;
end
else begin
  locked_del_write [0] <= locked;
  locked_del_write [9:1] <= locked_del_write [8:0];
  start_write_cdc <= start_apg;
  start_write1 <= start_write_cdc;
  start_write <= start_write1;
end
end

assign write_aresetn = locked_del_write[9];


always @ ( posedge audio_clk) begin
if (~locked || reset) begin
  locked_del_audio <= 0;
end
else begin
  locked_del_audio [0] <= locked;
  locked_del_audio [9:1] <= locked_del_audio [8:0];
end
end

assign audio_aresetn = locked_del_write[9];

//-------------------------


 axi_traffic_gen_0 ATG0
   (
    .s_axi_aclk            (write_clk),
    .s_axi_aresetn         (lite_aresetn_1),  // release the reset after 10 clock
    .m_axi_lite_ch1_awaddr (AXI_AWADDR),
    .m_axi_lite_ch1_awprot (),
    .m_axi_lite_ch1_awvalid(AXI_AWVALID),
    .m_axi_lite_ch1_awready(AXI_AWREADY),
    .m_axi_lite_ch1_wdata  (AXI_WDATA),
    .m_axi_lite_ch1_wstrb  (AXI_WSTRB),
    .m_axi_lite_ch1_wvalid (AXI_WVALID),
    .m_axi_lite_ch1_wready (AXI_WREADY),
    .m_axi_lite_ch1_bresp  (AXI_BRESP),
    .m_axi_lite_ch1_bvalid (AXI_BVALID),
    .m_axi_lite_ch1_bready (AXI_BREADY),
    .m_axi_lite_ch1_araddr (AXI_ARADDR),
    .m_axi_lite_ch1_arvalid(AXI_ARVALID),
    .m_axi_lite_ch1_arready(AXI_ARREADY),
    .m_axi_lite_ch1_rdata  (AXI_RDATA),
    .m_axi_lite_ch1_rvalid (AXI_RVALID),
    .m_axi_lite_ch1_rready (AXI_RREADY),
    .m_axi_lite_ch1_rresp  (AXI_RRESP),
    .done                  (start_apg), // trigger to start APG
    .status                ( )
  );



  <=: ComponentName :> audio_formatter_0
       (
<: if {$mm2s_enabled} { :>
        .m_axis_mm2s_aclk(write_clk),
        .m_axis_mm2s_aresetn(write_aresetn),
       // .m_axis_mm2s_aclk(read_clk),
       // .m_axis_mm2s_aresetn(read_aresetn),
        .m_axis_mm2s_tdata(m_axis_mm2s_TDATA),
        .m_axis_mm2s_tid(m_axis_mm2s_TID),
        .m_axis_mm2s_tready(m_axis_mm2s_TREADY),
        .m_axis_mm2s_tvalid(m_axis_mm2s_TVALID),
        .m_axi_mm2s_araddr(m_axi_mm2s_ARADDR),
        .m_axi_mm2s_arburst(m_axi_mm2s_ARBURST),
        .m_axi_mm2s_arcache(m_axi_mm2s_ARCACHE),
        .m_axi_mm2s_arlen(m_axi_mm2s_ARLEN),
        .m_axi_mm2s_arprot(m_axi_mm2s_ARPROT),
        .m_axi_mm2s_arready(m_axi_mm2s_ARREADY),
        .m_axi_mm2s_arsize(m_axi_mm2s_ARSIZE),
        .m_axi_mm2s_aruser(m_axi_mm2s_ARUSER),
        .m_axi_mm2s_arvalid(m_axi_mm2s_ARVALID),
        .m_axi_mm2s_rdata(m_axi_mm2s_RDATA),
        .m_axi_mm2s_rlast(m_axi_mm2s_RLAST),
        .m_axi_mm2s_rready(m_axi_mm2s_RREADY),
        .m_axi_mm2s_rresp(m_axi_mm2s_RRESP),
        .m_axi_mm2s_rvalid(m_axi_mm2s_RVALID),
        .irq_mm2s(Irq_mm2s),
        //.aud_mclk(audio_clk),
        //.aud_mreset(~audio_aresetn),
        .aud_mclk(write_clk),
        .aud_mreset(~write_aresetn),
<: } :>
<: if {$s2mm_enabled} { :>
        .s_axis_s2mm_aclk(write_clk),
        .s_axis_s2mm_aresetn(write_aresetn),
        .m_axi_s2mm_awaddr(m_axi_s2mm_AWADDR),
        .m_axi_s2mm_awburst(m_axi_s2mm_AWBURST),
        .m_axi_s2mm_awcache(m_axi_s2mm_AWCACHE),
        .m_axi_s2mm_awlen(m_axi_s2mm_AWLEN),
        .m_axi_s2mm_awprot(m_axi_s2mm_AWPROT),
        .m_axi_s2mm_awready(m_axi_s2mm_AWREADY),
        .m_axi_s2mm_awsize(m_axi_s2mm_AWSIZE),
        .m_axi_s2mm_awuser(m_axi_s2mm_AWUSER),
        .m_axi_s2mm_awvalid(m_axi_s2mm_AWVALID),
        .m_axi_s2mm_bready(m_axi_s2mm_BREADY),
        .m_axi_s2mm_bresp(m_axi_s2mm_BRESP),
        .m_axi_s2mm_bvalid(m_axi_s2mm_BVALID),
        .m_axi_s2mm_wdata(m_axi_s2mm_WDATA),
        .m_axi_s2mm_wlast(m_axi_s2mm_WLAST),
        .m_axi_s2mm_wready(m_axi_s2mm_WREADY),
        .m_axi_s2mm_wstrb(m_axi_s2mm_WSTRB),
        .m_axi_s2mm_wvalid(m_axi_s2mm_WVALID),
        .s_axis_s2mm_tdata(s_axis_s2mm_TDATA),
        .s_axis_s2mm_tid(s_axis_s2mm_TID),
        .s_axis_s2mm_tready(s_axis_s2mm_TREADY),
        .s_axis_s2mm_tvalid(s_axis_s2mm_TVALID),
        .irq_s2mm(Irq_s2mm),
<: } :>
        .s_axi_lite_aclk(write_clk),
        .s_axi_lite_aresetn(lite_aresetn),
        .s_axi_lite_araddr(AXI_ARADDR[11:0]),
        .s_axi_lite_arready(AXI_ARREADY),
        .s_axi_lite_arvalid(AXI_ARVALID),
        .s_axi_lite_awaddr(AXI_AWADDR[11:0]),
        .s_axi_lite_awready(AXI_AWREADY),
        .s_axi_lite_awvalid(AXI_AWVALID),
        .s_axi_lite_bready(AXI_BREADY),
        .s_axi_lite_bresp(AXI_BRESP),
        .s_axi_lite_bvalid(AXI_BVALID),
        .s_axi_lite_rdata(AXI_RDATA),
        .s_axi_lite_rready(AXI_RREADY),
        .s_axi_lite_rresp(AXI_RRESP),
        .s_axi_lite_rvalid(AXI_RVALID),
        .s_axi_lite_wdata(AXI_WDATA),
        .s_axi_lite_wready(AXI_WREADY),
        .s_axi_lite_wvalid(AXI_WVALID)
);

<: if {$mm2s_enabled == 1} { :>

always @ ( posedge write_clk) begin
if (~lite_aresetn) begin
  lite_aresetn_1 <= 1'b0;
end
else begin
	if(Irq_s2mm_1) begin
		lite_aresetn_1 <= 1'b1;
	end
end
end

exdes_axis_gen #(
	.C_NUM_CHANNELS(2),
	.DATAFORMAT( <=: $c_dataformat_gen :> )
) generator_1
(
 .clk(write_clk),
 .resetn(write_aresetn),

 .DataGen_Enable(write_aresetn),
 .m_axis_audio_tready(s_axis_s2mm_TREADY_1),
 .m_axis_audio_tvalid(s_axis_s2mm_TVALID_1),
 .m_axis_audio_tid(s_axis_s2mm_TID_1),
 .m_axis_audio_tdata(s_axis_s2mm_TDATA_1)
);

// To generate data in buffer for MM2S DUT
  audio_formatter_s2mm audio_formatter_1
       (
        .s_axis_s2mm_aclk(write_clk),
        .s_axis_s2mm_aresetn(write_aresetn),
        .m_axi_s2mm_awaddr(m_axi_s2mm_AWADDR_1),
        .m_axi_s2mm_awburst(m_axi_s2mm_AWBURST_1),
        .m_axi_s2mm_awcache(m_axi_s2mm_AWCACHE_1),
        .m_axi_s2mm_awlen(m_axi_s2mm_AWLEN_1),
        .m_axi_s2mm_awprot(m_axi_s2mm_AWPROT_1),
        .m_axi_s2mm_awready(m_axi_s2mm_AWREADY_1),
        .m_axi_s2mm_awsize(m_axi_s2mm_AWSIZE_1),
        .m_axi_s2mm_awuser(m_axi_s2mm_AWUSER_1),
        .m_axi_s2mm_awvalid(m_axi_s2mm_AWVALID_1),
        .m_axi_s2mm_bready(m_axi_s2mm_BREADY_1),
        .m_axi_s2mm_bresp(m_axi_s2mm_BRESP_1),
        .m_axi_s2mm_bvalid(m_axi_s2mm_BVALID_1),
        .m_axi_s2mm_wdata(m_axi_s2mm_WDATA_1),
        .m_axi_s2mm_wlast(m_axi_s2mm_WLAST_1),
        .m_axi_s2mm_wready(m_axi_s2mm_WREADY_1),
        .m_axi_s2mm_wstrb(m_axi_s2mm_WSTRB_1),
        .m_axi_s2mm_wvalid(m_axi_s2mm_WVALID_1),
        .s_axis_s2mm_tdata(s_axis_s2mm_TDATA_1),
        .s_axis_s2mm_tid(s_axis_s2mm_TID_1),
        .s_axis_s2mm_tready(s_axis_s2mm_TREADY_1),
        .s_axis_s2mm_tvalid(s_axis_s2mm_TVALID_1),
        .irq_s2mm(Irq_s2mm_1),

        .s_axi_lite_aclk(write_clk),
        .s_axi_lite_aresetn(lite_aresetn),
        .s_axi_lite_araddr(AXI_ARADDR_1[11:0]),
        .s_axi_lite_arready(AXI_ARREADY_1),
        .s_axi_lite_arvalid(AXI_ARVALID_1),
        .s_axi_lite_awaddr(AXI_AWADDR_1[11:0]),
        .s_axi_lite_awready(AXI_AWREADY_1),
        .s_axi_lite_awvalid(AXI_AWVALID_1),
        .s_axi_lite_bready(AXI_BREADY_1),
        .s_axi_lite_bresp(AXI_BRESP_1),
        .s_axi_lite_bvalid(AXI_BVALID_1),
        .s_axi_lite_rdata(AXI_RDATA_1),
        .s_axi_lite_rready(AXI_RREADY_1),
        .s_axi_lite_rresp(AXI_RRESP_1),
        .s_axi_lite_rvalid(AXI_RVALID_1),
        .s_axi_lite_wdata(AXI_WDATA_1),
        .s_axi_lite_wready(AXI_WREADY_1),
        .s_axi_lite_wvalid(AXI_WVALID_1)
);

 axi_traffic_gen_1 ATG1
   (
    .s_axi_aclk            (write_clk),
    .s_axi_aresetn         (lite_aresetn),  // release the reset after 10 clock
    .m_axi_lite_ch1_awaddr (AXI_AWADDR_1),
    .m_axi_lite_ch1_awprot (),
    .m_axi_lite_ch1_awvalid(AXI_AWVALID_1),
    .m_axi_lite_ch1_awready(AXI_AWREADY_1),
    .m_axi_lite_ch1_wdata  (AXI_WDATA_1),
    .m_axi_lite_ch1_wstrb  (AXI_WSTRB_1),
    .m_axi_lite_ch1_wvalid (AXI_WVALID_1),
    .m_axi_lite_ch1_wready (AXI_WREADY_1),
    .m_axi_lite_ch1_bresp  (AXI_BRESP_1),
    .m_axi_lite_ch1_bvalid (AXI_BVALID_1),
    .m_axi_lite_ch1_bready (AXI_BREADY_1),
    .m_axi_lite_ch1_araddr (AXI_ARADDR_1),
    .m_axi_lite_ch1_arvalid(AXI_ARVALID_1),
    .m_axi_lite_ch1_arready(AXI_ARREADY_1),
    .m_axi_lite_ch1_rdata  (AXI_RDATA_1),
    .m_axi_lite_ch1_rvalid (AXI_RVALID_1),
    .m_axi_lite_ch1_rready (AXI_RREADY_1),
    .m_axi_lite_ch1_rresp  (AXI_RRESP_1),
    .done                  (), // trigger to start APG
    .status                ( )
  );

exdes_axis_chk checker_1
(
 .clk(write_clk),
 .resetn(write_aresetn),

