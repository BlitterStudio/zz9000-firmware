xpm_memory_spram
   #(

    // Common module generics
    .MEMORY_SIZE        (1024 * 32),        //positive integer
    .MEMORY_PRIMITIVE   ("auto"),      //string; "auto", "distributed", "block" or "ultra" ;
    .MEMORY_INIT_FILE   ("memory.mem"),      //string; "none" or "<filename>.mem"
    .MEMORY_INIT_PARAM  (""),          //string;
    .USE_MEM_INIT       (0),           //integer; 0,1
    .WAKEUP_TIME        ("disable_sleep"),//string; "disable_sleep" or "use_sleep_pin"
    .MESSAGE_CONTROL    (0),           //integer; 0,1
    .ECC_MODE           ("no_ecc"),    //string; "no_ecc", "encode_only", "decode_only" or "both_encode_and_decode"
    .AUTO_SLEEP_TIME    (0),           //Do not Change


    .WRITE_DATA_WIDTH_A (32),          //positive integer
    .READ_DATA_WIDTH_A  (32),          //positive integer
    .BYTE_WRITE_WIDTH_A (8),          //integer; 8, 9, or WRITE_DATA_WIDTH_A value
    .ADDR_WIDTH_A       (10),           //positive integer
    .READ_RESET_VALUE_A ("0"),         //string
    .READ_LATENCY_A     (1),           //non-negative integer
    .WRITE_MODE_A       ("read_first") //string; "write_first", "read_first", "no_change"
  ) xpm_memory_spram_inst_1
  (

    // Common module ports
    .sleep          (1'b0),

    .clka           (BRAM_Clk_A_1),
    .rsta           (BRAM_Rst_A_1),
    .ena            (BRAM_En_A_1),
    .regcea         (1'b1), //regcea),
    .wea            (BRAM_WE_A_1),
    .addra          (BRAM_Addr_A_1[11:2]),
    .dina           (BRAM_WrData_A_1),
    .injectsbiterra (1'b0),
    .injectdbiterra (1'b0),
    .douta          (BRAM_RdData_A_1),
    .sbiterra       (),
    .dbiterra       ()
  );

<: } else { :>

always @ ( posedge write_clk) begin
if (~lite_aresetn) begin
  lite_aresetn_1 <= 1'b0;
end
else begin
	lite_aresetn_1 <= 1'b1;
end
end

assign DataChk_InSync = 1'b1;
assign DataChk_Error = 1'b0;

<: } :>

<: if {$s2mm_enabled == 0} { :>
assign m_axi_s2mm_AWVALID = 1'b0;
assign m_axi_s2mm_AWADDR = 'd0;
assign m_axi_s2mm_WVALID  = 1'b0;
assign m_axi_s2mm_BREADY  = 1'b0;
<: } :>
<: if {$mm2s_enabled == 0} { :>
assign m_axi_mm2s_ARVALID = 1'b0;
assign m_axi_mm2s_ARADDR = 'd0;
assign m_axi_mm2s_RREADY  = 1'b0;
<: } :>

<: if {$s2mm_enabled == 1} { :>
wire Error_s2mm = ~s2mm_good;
always@(posedge write_clk) begin
	if (~write_aresetn) begin
		s2mm_good	<= 1'b1;
	end
	else begin
		if(m_axi_s2mm_BVALID && (m_axi_s2mm_BRESP != 'd0)) begin
			s2mm_good	<= 1'b0;
		end
	end
end


