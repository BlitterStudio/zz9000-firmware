<: set ComponentName [getComponentNameString] :>
<: setFileName [ttcl_string_concat "exdes" "_axis_gen"] :>
<: setFileExtension ".sv" :>
<: setOutputDirectory [ttcl_string_concat "./" $ComponentName "/example_design"] :>
<: set c_num_i2s_channels [getIntValue "C_MAX_NUM_CHANNELS_S2MM"] :>
<: set s2mm_data_format [getIntValue "C_S2MM_DATAFORMAT"] :>
<: set c_data_width 24 :>
