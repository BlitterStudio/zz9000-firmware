//tb
`timescale 1ns/1ps
(* DowngradeIPIdentifiedWarnings="yes" *)
module exdes_axis_gen #(
	parameter integer C_NUM_CHANNELS = 2,
	parameter integer DATAFORMAT = 1
)
(
	input clk,
	input resetn,

	input  DataGen_Enable,
	input  m_axis_audio_tready,
	output m_axis_audio_tvalid,
	output  [7:0] m_axis_audio_tid,
	output [31:0] m_axis_audio_tdata
);

//logic [<=: c_data_width :> -1:0] DataGen_SampleValues [<=: c_num_i2s_channels :>];
logic [<=: c_data_width :> -1:0] DataGen_SampleValues [C_NUM_CHANNELS - 1: 0];
logic [191:0]  DataGen_ChannelStatus = {32'h01234567, 
                			32'h89ABCDEF,
                			32'hAABBCCDD,
                			32'hEEFF0011,
                			32'h22334455,
                			32'h66778899};
logic [31:0]   DataGen_ChannelCounter;
logic [31:0]   DataGen_FrameCounter;
logic [31:0]   DataGen_AesOut;

logic [3:0] cAES_BSYNC   = 4'b0001;
logic [3:0] cAES_SF1SYNC = 4'b0010;
logic [3:0] cAES_SF2SYNC = 4'b0011;

logic        nAxis_TValid;
logic        nAxis_TReady;
logic [ 2:0] nAxis_TID;
logic [31:0] nAxis_TData;

logic sample_pulse;
logic [8:0] sample_count;

assign m_axis_audio_tvalid = nAxis_TValid && sample_pulse; 
assign m_axis_audio_tid = {5'd0,nAxis_TID}; 

generate if(DATAFORMAT < 2) begin: AES
// if {$s2mm_data_format < 2} { 
//AES
assign m_axis_audio_tdata = nAxis_TData;
// } 
end
else begin: PCM
// if {$s2mm_data_format > 1} { 
//PCM
assign m_axis_audio_tdata = {8'd0,nAxis_TData[27:4]};
// } 
end
endgenerate
assign nAxis_TReady = m_axis_audio_tready; 

always_ff @(posedge clk)
begin
  if(!resetn || !DataGen_Enable) begin
    sample_pulse <= 1'b0;
    sample_count <= 'd0;
  end
  else if(sample_count == 'd0) begin
	if(m_axis_audio_tvalid && m_axis_audio_tready) begin
		//if(m_axis_audio_tid < (( <=: c_num_i2s_channels :> )-1)) begin
		if(m_axis_audio_tid < (( C_NUM_CHANNELS )-1)) begin
    			sample_pulse <= 1'b1;
    			sample_count <= 'd0;
		end
		else begin
    			sample_pulse <= 1'b0;
    			sample_count <= 'd383 - 'd5;
		end
        end
	else begin
    		sample_pulse <= 1'b1;
    		sample_count <= 'd0;
        end
  end
  else if(nAxis_TValid) begin
    sample_count <= sample_count - 1'b1;
    sample_pulse <= 'd0;
  end
  else begin
    sample_count <= sample_count;
    sample_pulse <= sample_pulse;
  end
end

always_ff @(posedge clk)
begin
  if (!resetn || !DataGen_Enable) begin
    nAxis_TValid <= 1'b0;
    DataGen_ChannelCounter = 0;
    DataGen_FrameCounter = 0;
    nAxis_TID <= 'd0;
    nAxis_TData <= 'd0;
    foreach (DataGen_SampleValues[i]) begin
      DataGen_SampleValues[i] = 0;
    end
  end
  else begin
    
    if (!nAxis_TValid || 
       (m_axis_audio_tvalid & nAxis_TReady)) begin
      nAxis_TValid <= 1'b1;
      
      nAxis_TID    <= DataGen_ChannelCounter;
      
      DataGen_AesOut[31] = 1'b0;
      DataGen_AesOut[30] = DataGen_ChannelStatus[DataGen_FrameCounter];
      DataGen_AesOut[29] = 1'b0;
      DataGen_AesOut[28] = 1'b0;
      DataGen_AesOut[27-: <=: c_data_width :> ] = DataGen_SampleValues[DataGen_ChannelCounter];
      nAxis_TData[31:4] <= DataGen_AesOut[31:4];
      
      if (DataGen_ChannelCounter[0] == 1'b0) begin
        if (DataGen_FrameCounter == 'd0) begin
          nAxis_TData[3:0] <= cAES_BSYNC;
        end
        else begin
          nAxis_TData[3:0] <= cAES_SF1SYNC;
        end
      end
      else begin
        nAxis_TData[3:0] <= cAES_SF2SYNC;
      end
      
      //if (DataGen_ChannelCounter < ( <=: c_num_i2s_channels :> )-1) begin
      if (DataGen_ChannelCounter < (  C_NUM_CHANNELS  )-1) begin
        DataGen_ChannelCounter <= DataGen_ChannelCounter + 1'b1;
      end
      else begin
        DataGen_ChannelCounter <= 'd0;
        
        if (DataGen_FrameCounter < 'd191) begin
          DataGen_FrameCounter <= DataGen_FrameCounter + 1'b1;
        end
        else begin
          DataGen_FrameCounter <= 0;
        end
        
        foreach (DataGen_SampleValues[i]) begin
          if (DataGen_SampleValues[i] < 255) begin
            DataGen_SampleValues[i] = DataGen_SampleValues[i] + 1;
          end
          else begin
            DataGen_SampleValues[i] = 0;
          end
        end
      end
    end
  end
end




endmodule
