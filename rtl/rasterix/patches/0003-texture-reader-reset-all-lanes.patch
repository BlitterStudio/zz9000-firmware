+            rTexel11 <= { TEXEL_WIDTH { 1'b0 } };
+            m_tr_texel_00 <= { TEXEL_WIDTH { 1'b0 } };
+            m_tr_texel_01 <= { TEXEL_WIDTH { 1'b0 } };
+            m_tr_texel_10 <= { TEXEL_WIDTH { 1'b0 } };
+            m_tr_texel_11 <= { TEXEL_WIDTH { 1'b0 } };
         end
