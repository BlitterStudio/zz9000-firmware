#!/usr/bin/env python3
"""Fail unless a shipped app image matches the loader contract.

Today's relocation rules, plus the ZZAPP note: present, magic 0x50505A41,
abi major 0, only known flag bits, and a stack the loader will accept.
"""
import struct
import sys

EHDR = struct.Struct("<16sHHIIIIIHHHHHH")
SHDR = struct.Struct("<IIIIIIIIII")
PHDR = struct.Struct("<IIIIIIII")
RELA = struct.Struct("<III")
REL = struct.Struct("<II")
SHT_RELA = 4
SHT_REL = 9
SHT_NOTE = 7
SHT_DYNAMIC = 6
PT_LOAD = 1
PT_INTERP = 3
SHF_ALLOC = 2
PF_W = 2
PF_X = 1
R_ARM_RELATIVE = 23
DT_NEEDED = 1
NOTE_MAGIC = 0x50505A41
NOTE_FLAG_KNOWN = 0x7  # display | audio | gl
STACK_MIN = 64 << 10
STACK_MAX = 1 << 20


def die(path, msg):
    sys.stderr.write("%s: %s\n" % (path, msg))
    sys.exit(1)


def check_note(path, note):
    if len(note) < 12:
        die(path, "ZZAPP note is short")
    namesz, descsz, ntype = struct.unpack_from("<III", note, 0)
    if namesz != 6 or descsz != 24 or ntype != 1:
        die(path, "ZZAPP note header %d %d %d" % (namesz, descsz, ntype))
    owner = note[12:12 + namesz]
    if owner != b"ZZAPP\x00":
        die(path, "note owner is %r" % (owner,))
    desc_off = 12 + ((namesz + 3) & ~3)
    if desc_off + descsz > len(note):
        die(path, "ZZAPP note descriptor %d bytes, note has %d"
            % (descsz, len(note) - desc_off))
    magic, abi_major, abi_minor, stack, flags, reserved = struct.unpack_from(
        "<IIIIII", note, desc_off)
    del abi_minor, reserved
    if magic != NOTE_MAGIC:
        die(path, "note magic 0x%x" % magic)
    if abi_major != 0:
        die(path, "note abi major %d is not 0" % abi_major)
    if flags & ~NOTE_FLAG_KNOWN:
        die(path, "note flags 0x%x has unknown bits" % flags)
    if stack != 0 and (stack < STACK_MIN or stack > STACK_MAX or (stack & 7) != 0):
        die(path, "note stack %d is not 0 or 64 KiB..1 MiB aligned to 8" % stack)


def check(path):
    try:
        blob = open(path, "rb").read()
    except OSError as exc:
        die(path, str(exc))
    if len(blob) < EHDR.size or blob[:4] != b"\x7fELF" or blob[4] != 1 or blob[5] != 1:
        die(path, "not a little-endian ELF32")
    try:
        (ident, etype, machine, version, entry, phoff, shoff, flags, ehsize,
         phentsize, phnum, shentsize, shnum, shstrndx) = EHDR.unpack_from(blob, 0)
    except struct.error:
        die(path, "truncated ELF header")
    del ident, version, flags, ehsize
    if etype != 3:
        die(path, "e_type is not ET_DYN")
    if machine != 40:
        die(path, "not EM_ARM")
    if shoff + shnum * shentsize > len(blob) or phoff + phnum * phentsize > len(blob):
        die(path, "truncated ELF program or section headers")
    if shentsize < SHDR.size or phentsize < PHDR.size:
        die(path, "unexpected ELF header size")
    try:
        shdrs = [SHDR.unpack_from(blob, shoff + i * shentsize) for i in range(shnum)]
        phdrs = [PHDR.unpack_from(blob, phoff + i * phentsize) for i in range(phnum)]
    except struct.error:
        die(path, "truncated ELF program or section headers")
    if shstrndx >= shnum:
        die(path, "section name table is missing")
    names_off, names_size = shdrs[shstrndx][4], shdrs[shstrndx][5]
    if names_off + names_size > len(blob):
        die(path, "truncated section name table")
    names = blob[names_off:names_off + names_size]

    def sname(off):
        if off >= len(names):
            return ""
        end = names.find(b"\x00", off)
        if end < 0:
            end = len(names)
        return names[off:end].decode("ascii", "replace")

    loads = 0
    interp = False
    for p_type, p_offset, p_vaddr, p_paddr, p_filesz, p_memsz, p_flags, p_align in phdrs:
        del p_offset, p_vaddr, p_paddr, p_filesz, p_memsz, p_align
        if p_type == PT_INTERP:
            interp = True
        if p_type == PT_LOAD:
            loads += 1
            if (p_flags & PF_W) and (p_flags & PF_X):
                die(path, "PT_LOAD is writable and executable")
    if interp:
        die(path, "PT_INTERP is present")
    if loads > 4:
        die(path, "%d PT_LOAD segments" % loads)
    if loads < 1:
        die(path, "no PT_LOAD")

    saw_reloc = False
    saw_note = False
    for name, typ, shflags, addr, off, size, link, info, addralign, entsize in shdrs:
        del addr, link, info, addralign, entsize
        if typ in (SHT_REL, SHT_RELA) and (shflags & SHF_ALLOC):
            saw_reloc = True
            section = sname(name)
            if section not in (".rel.dyn", ".rela.dyn"):
                die(path, "allocated relocation is named %s" % section)
            stride = 8 if typ == SHT_REL else 12
            if size % stride:
                die(path, "%s size is not a multiple of %d" % (section, stride))
            if off + size > len(blob):
                die(path, "%s extends past the file" % section)
            for n in range(size // stride):
                if typ == SHT_REL:
                    r_offset, r_info = REL.unpack_from(blob, off + n * stride)
                else:
                    r_offset, r_info, r_addend = RELA.unpack_from(
                        blob, off + n * stride)
                    del r_addend
                if (r_info & 0xFF) != R_ARM_RELATIVE or (r_info >> 8) != 0:
                    die(path, "reloc %d is not R_ARM_RELATIVE/0" % n)
                del r_offset
        if typ == SHT_NOTE or sname(name) == ".note.zzapp":
            if off + size > len(blob):
                die(path, "ZZAPP note extends past the file")
            check_note(path, blob[off:off + size])
            saw_note = True
        if typ == SHT_DYNAMIC:
            if off + size > len(blob) or size % 8:
                die(path, "truncated SHT_DYNAMIC")
            for n in range(size // 8):
                tag, val = struct.unpack_from("<II", blob, off + n * 8)
                if tag == DT_NEEDED:
                    die(path, "DT_NEEDED")
                if tag == 0:
                    break
                del val
    if not saw_reloc:
        die(path, "no allocated .rel.dyn or .rela.dyn")
    if not saw_note:
        die(path, "no ZZAPP note")
    if entry != 0:
        # zz_start is the first text byte. A non-zero entry is not wrong if
        # the script ever inserts bytes before it; v0 links it at offset 0.
        pass
    sys.stdout.write("%s: R_ARM_RELATIVE only, ZZAPP note ok\n" % path)


def note_bytes(flags, stack):
    name = b"ZZAPP\x00\x00\x00"
    desc = struct.pack("<IIIIII", NOTE_MAGIC, 0, 0, stack, flags, 0)
    return struct.pack("<III", 6, 24, 1) + name + desc


def expect_note(path, flags, stack):
    try:
        blob = open(path, "rb").read()
    except OSError as exc:
        die(path, str(exc))
    if len(blob) < EHDR.size or blob[:4] != b"\x7fELF":
        die(path, "not a little-endian ELF32")
    try:
        (ident, etype, machine, version, entry, phoff, shoff, eflags, ehsize,
         phentsize, phnum, shentsize, shnum, shstrndx) = EHDR.unpack_from(blob, 0)
    except struct.error:
        die(path, "truncated ELF header")
    del ident, etype, machine, version, entry, phoff, eflags, ehsize, phentsize, phnum
    if shoff + shnum * shentsize > len(blob) or shstrndx >= shnum:
        die(path, "truncated ELF section headers")
    shdrs = [SHDR.unpack_from(blob, shoff + i * shentsize) for i in range(shnum)]
    names_off, names_size = shdrs[shstrndx][4], shdrs[shstrndx][5]
    names = blob[names_off:names_off + names_size]
    want = note_bytes(flags, stack)
    for name, typ, shflags, addr, off, size, link, info, align, entsize in shdrs:
        del typ, shflags, addr, link, info, align, entsize
        end = names.find(b"\x00", name)
        if names[name:end] == b".note.zzapp":
            got = blob[off:off + size]
            if got != want:
                die(path, "note bytes %s, expected %s" % (got.hex(), want.hex()))
            sys.stdout.write("%s: .note.zzapp matches flags=%d stack=%d\n"
                             % (path, flags, stack))
            return
    die(path, "no .note.zzapp section")


def main(argv):
    if len(argv) >= 2 and argv[1] == "--expect-note":
        if len(argv) != 5:
            die("zzapp-check", "usage: zzapp-check --expect-note <elf> <flags> <stack>")
        expect_note(argv[2], int(argv[3], 0), int(argv[4], 0))
        return
    if len(argv) < 2:
        die("zzapp-check", "usage: zzapp-check <elf>...")
    for path in argv[1:]:
        check(path)


if __name__ == "__main__":
    main(sys.argv)
